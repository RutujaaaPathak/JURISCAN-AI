# JURISCAN-AI environment configuration
# Copy this file to .env and fill in your values. Never commit a real .env.

# Application
APP_NAME=JURISCAN-AI
APP_ENV=development          # development | test | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api

# Frontend
# Origin(s) allowed by the backend CORS policy. JSON array of origins.
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
FRONTEND_PORT=3000           # documentational; the Vite dev server runs on 5173

# Database (PostgreSQL)
# Provide either DATABASE_URL or the individual DB_* fields below.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/juriscan
DB_HOST=localhost
DB_PORT=5432
DB_NAME=juriscan
DB_USER=postgres
DB_PASSWORD=

# Logging / validation
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=25

# AI / ML (optional, reserved for later phases)
# Add your AI model provider keys here (e.g., OpenAI, HuggingFace).
OPENAI_API_KEY=
HF_TOKEN=

# Storage
DATA_DIR=./data
MODELS_DIR=./models