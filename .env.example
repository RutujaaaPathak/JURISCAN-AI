# JURISCAN-AI environment configuration
# Copy this file to .env and fill in your values. Never commit a real .env.

# Application
APP_NAME=JURISCAN-AI
APP_ENV=development          # development | test | staging | production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api

# Development/test only: allow requests with no bearer token to use the demo
# user. Never enable this in production or staging.
ALLOW_DEMO_USER=false

# Frontend
# Origin allowed by the backend CORS policy. In production this must be your
# deployed frontend origin (for example https://app.example.com).
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database
# Provide either DATABASE_URL or the individual DB_* fields below.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/juriscan
DB_HOST=localhost
DB_PORT=5432
DB_NAME=juriscan
DB_USER=postgres
DB_PASSWORD=

# Auth
# REQUIRED in production and staging. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# In development/test, leaving this empty generates a random per-process key.
SECRET_KEY=
ACCESS_TOKEN_TTL_SECONDS=604800

# Brute-force protection for /auth/login and /auth/register. Per client IP,
# per process (each uvicorn worker counts separately). 0 disables it.
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Logging / validation
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=25
# Reject PDFs above this page count before text extraction/OCR begins.
MAX_PDF_PAGES=500

# OCR for scanned/image-only PDF pages (optional). Requires the
# rapidocr-onnxruntime and pymupdf packages; when they are absent OCR is skipped.
OCR_ENABLED=true
OCR_MIN_PAGE_CHARS=20
OCR_RENDER_DPI=200
# Render/recognise at most this many page images at once (memory bound).
OCR_PAGE_BATCH_SIZE=1
# Overall OCR deadline per document. PROCESSING_STALE_SECONDS must stay higher.
OCR_TIMEOUT_SECONDS=300
# Keep at 1 for the lowest memory use; each concurrent slot owns an OCR engine.
OCR_MAX_CONCURRENT_INFERENCES=1
# OpenCV page preparation: border cleanup, 90-degree orientation, deskew and
# contrast/threshold enhancement. Set OCR_PREPROCESS_ENABLED=false to bypass.
OCR_PREPROCESS_ENABLED=true
OCR_DESKEW_ENABLED=true
OCR_ROTATION_DETECTION_ENABLED=true
OCR_LAYOUT_ANALYSIS_ENABLED=true
# Confidence thresholds for low-confidence lines, document warnings and the
# native-vs-OCR merge margin (all 0..1).
OCR_LOW_CONFIDENCE_THRESHOLD=0.75
OCR_QUALITY_WARNING_THRESHOLD=0.65
OCR_NATIVE_RECHECK_THRESHOLD=0.45
OCR_MERGE_MARGIN=0.08

# Document processing. Jobs run in bounded background threads with independent
# database sessions; uploads still wait for the final result.
PROCESSING_MAX_CONCURRENT_JOBS=2
PROCESSING_STALE_SECONDS=900
# Set to 0 to disable the periodic stale-document sweep.
PROCESSING_STALE_SWEEP_SECONDS=300

# Storage
DATA_DIR=./data
MODELS_DIR=./models

# ----------------------------------------------------------------------------
# Production checklist (see docs/LAUNCH_CHECKLIST.md)
# ----------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# SECRET_KEY=<a long random value, unique to production>
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<name>
# FRONTEND_ORIGIN=https://<your-frontend-domain>
# CORS_ORIGINS=["https://<your-frontend-domain>"]
