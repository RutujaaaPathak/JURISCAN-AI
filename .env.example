# JURISCAN-AI environment configuration
# Copy this file to .env and fill in your values. Never commit a real .env.

# Application
APP_NAME=JURISCAN-AI
APP_ENV=development          # development | test | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api

# Frontend
# Origin allowed by the backend CORS policy. In production this must be your
# deployed frontend origin (for example https://app.example.com).
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database
# Provide either DATABASE_URL or the individual DB_* fields below.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/juriscan
DB_HOST=localhost
DB_PORT=5432
DB_NAME=juriscan
DB_USER=postgres
DB_PASSWORD=

# Auth
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=604800

# Logging / validation
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=25

# OCR for scanned/image-only PDF pages (optional). Requires the
# rapidocr-onnxruntime and pymupdf packages; when they are absent OCR is skipped.
OCR_ENABLED=true
OCR_MIN_PAGE_CHARS=20
OCR_RENDER_DPI=200

# Storage
DATA_DIR=./data
MODELS_DIR=./models

# ----------------------------------------------------------------------------
# Production checklist (see docs/LAUNCH_CHECKLIST.md)
# ----------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# SECRET_KEY=<a long random value, unique to production>
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<name>
# FRONTEND_ORIGIN=https://<your-frontend-domain>
# CORS_ORIGINS=["https://<your-frontend-domain>"]
