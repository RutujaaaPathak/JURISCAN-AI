# JURISCAN-AI environment configuration
# Copy this file to .env and fill in your values.

# Application
APP_NAME=JURISCAN-AI
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=juriscan
DB_USER=postgres
DB_PASSWORD=

# AI / ML
# Add your AI model provider keys here (e.g., OpenAI, HuggingFace)
OPENAI_API_KEY=
HF_TOKEN=

# Frontend
FRONTEND_PORT=3000

# Storage
DATA_DIR=./data
MODELS_DIR=./models
