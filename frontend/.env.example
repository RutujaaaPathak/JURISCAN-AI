# Copy to .env.local (gitignored) to override for your machine.
# Base URL of the backend API, without a trailing slash.
VITE_API_BASE_URL=http://localhost:8000/api

# In production, point this at your deployed API, e.g.
# VITE_API_BASE_URL=https://api.example.com/api
# Rebuild the frontend after changing this value (it is baked in at build time).

# WebRTC voice calling
# Public STUN server used for NAT traversal. The code falls back to this value.
VITE_WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302
# Optional TURN relay for restrictive networks. Leave blank to disable.
# Never commit real TURN credentials; provide them per deployment.
VITE_WEBRTC_TURN_SERVER=
VITE_WEBRTC_TURN_USERNAME=
VITE_WEBRTC_TURN_CREDENTIAL=
